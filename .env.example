# Server-only: set ENV=production on Render. Required in production:
# ALLOWED_ORIGINS, DATABASE_URL (postgresql://), RPC_URL, CHAIN_ID,
# CONTRACT_ADDRESS, VERIFIER_PRIVATE_KEY, TURNSTILE_SECRET, and PORT.
# Render supplies PORT automatically.
ENV=development
PORT=8000

# Server-only: testnet network and contract administration
CHAIN_NAME=
CHAIN_ID=
RPC_URL=
DEPLOYER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
EXPLORER_API_KEY=
EXPLORER_BASE_URL=
CONTRACT_ADDRESS=
DEPLOYER_ADDRESS=

# Server-only: external services and operations
PINATA_JWT=
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
TURNSTILE_SECRET=
TURNSTILE_DEV_BYPASS=false
# Cached sample scenarios may be enabled in production, but still require
# TURNSTILE_SECRET and a public Cloudflare Turnstile site key.
CACHED_DEMO_MODE=false
DATABASE_URL=sqlite:///./carbonlens.db
SCORE_THRESHOLD=70
ALLOWED_ORIGINS=http://localhost:3000
DAILY_REGISTRATION_CAP=20
MAX_CONCURRENT_VERIFICATIONS=2
MAX_GAS_LIMIT=1000000
REGISTRATION_RECEIPT_TIMEOUT_SECONDS=60
SENTRY_DSN=

# Public browser configuration only; these values are visible to every visitor.
# Never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_EXPLORER_BASE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# This only selects cached sample data; it never bypasses Turnstile.
NEXT_PUBLIC_CACHED_DEMO_MODE=false
NEXT_PUBLIC_GITHUB_URL=https://github.com
