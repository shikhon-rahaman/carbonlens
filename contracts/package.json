{
  "name": "carbonlens-contracts",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node:local": "hardhat node --hostname 127.0.0.1 --port 8545",
    "deploy:local": "hardhat run scripts/deploy-local.js --network localhost",
    "coverage": "hardhat coverage",
    "lint": "solhint contracts/**/*.sol",
    "slither": "slither . --filter-paths \"node_modules|test\"",
    "deploy:testnet": "hardhat run scripts/deploy.js --network carbonlensTestnet",
    "verify:testnet": "hardhat run scripts/verify.js --network carbonlensTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@openzeppelin/contracts": "5.4.0",
    "hardhat": "2.28.0",
    "solhint": "6.0.0",
    "solidity-coverage": "0.8.16"
  },
  "dependencies": {
    "dotenv": "^18.0.8"
  }
}
